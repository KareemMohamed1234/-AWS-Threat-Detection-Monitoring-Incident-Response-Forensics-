{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow",
      "Action": ["ec2:DescribeVolumes", "ec2:CreateSnapshot", "ec2:CreateTags", "ec2:DescribeSnapshots"],
      "Resource": "*" },
    { "Effect": "Allow", "Action": "sns:Publish", "Resource": "arn:aws:sns:eu-north-1:<ACCOUNT_ID>:ir-alerts" }
  ]
}
