{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Isolate", "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:ModifyNetworkInterfaceAttribute", "ec2:CreateTags"],
      "Resource": "*" },
    { "Sid": "DeactivateKeys", "Effect": "Allow", "Action": "iam:UpdateAccessKey", "Resource": "arn:aws:iam::<ACCOUNT_ID>:user/*" },
    { "Sid": "StartRunbook", "Effect": "Allow", "Action": "ssm:StartAutomationExecution",
      "Resource": ["arn:aws:ssm:eu-north-1:<ACCOUNT_ID>:automation-definition/IR-ForensicSnapshotAndNotify:*",
                   "arn:aws:ssm:eu-north-1:<ACCOUNT_ID>:automation-definition/IR-ForensicSnapshotAndNotify"] },
    { "Sid": "PassAutomationRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/IR-SSMAutomationRole" },
    { "Sid": "Notify", "Effect": "Allow", "Action": "sns:Publish", "Resource": "arn:aws:sns:eu-north-1:<ACCOUNT_ID>:ir-alerts" }
  ]
}
